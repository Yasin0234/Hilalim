# Keep Gson / Retrofit model classes and fields
-keep class com.korkutsoftware.hilalim.api.** { *; }
-keep class com.korkutsoftware.hilalim.model.** { *; }
-keepclassmembers class com.korkutsoftware.hilalim.**$* {
    <fields>;
}
-keepattributes Signature,InnerClasses,EnclosingMethod
-keepattributes *Annotation*

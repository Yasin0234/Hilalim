<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Date/Location Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/date_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_gradient_card"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="-12dp"
                        android:alpha="0.22"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_logo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_hero_icon"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_calendar_rounded"
                                app:tint="@color/gold" />

                            <TextView
                                android:id="@+id/txt_hijri_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/hijri_date_mock"
                                android:textColor="@color/gold"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_location_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_hero_icon"
                                android:contentDescription="@string/select_location"
                                android:padding="8dp"
                                android:src="@drawable/ic_location_rounded"
                                app:tint="@color/gold" />

                            <TextView
                                android:id="@+id/txt_location_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/location_mock"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:alpha="0.85"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_forward_arrow"
                                app:tint="@color/gold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next Prayer Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/countdown_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:layout_constraintTop_toBottomOf="@id/date_card"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/lbl_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/next_prayer_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/btn_home_monthly_times"
                        app:layout_constraintEnd_toStartOf="@id/btn_home_monthly_times"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/btn_home_monthly_times" />

                    <ImageView
                        android:id="@+id/btn_home_monthly_times"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tool_icon"
                        android:clickable="true"
                        android:contentDescription="@string/tool_aylik_vakitler"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_aylik_vakitler"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/txt_next_prayer_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/next_prayer_name_mock"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/txt_next_prayer_countdown"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_home_monthly_times" />

                    <TextView
                        android:id="@+id/txt_next_prayer_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_countdown_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="@string/next_prayer_time_mock"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/txt_next_prayer_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/txt_next_prayer_name" />

                    <ProgressBar
                        android:id="@+id/prayer_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="18dp"
                        android:progress="65"
                        android:progressDrawable="@drawable/progress_rounded"
                        app:layout_constraintTop_toBottomOf="@id/txt_next_prayer_name" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Prayer Times List -->
            <LinearLayout
                android:id="@+id/prayer_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@id/countdown_card">

                <!-- Imsak -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_imsak"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_imsak"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_imsak"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/imsak"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_imsak_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/imsak_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gunes -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_gunes"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_gunes"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_gunes"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/gunes"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_gunes_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gunes_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ogle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ogle"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_ogle"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_ogle"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/ogle"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_ogle_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ogle_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ikindi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ikindi"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_ikindi"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_ikindi"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/ikindi"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_ikindi_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ikindi_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Aksam -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_aksam"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_aksam"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_aksam"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/aksam"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_aksam_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aksam_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Yatsi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_yatsi"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:id="@+id/ic_yatsi"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tool_icon"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_yatsi"
                            app:tint="@color/secondary" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/yatsi"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_yatsi_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/yatsi_time_mock"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Verse of the Day Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verse_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/prayer_list"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gold_gradient"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_book"
                            app:tint="@color/deep_charcoal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:letterSpacing="0.08"
                            android:text="@string/gunun_ayeti_title"
                            android:textColor="@color/deep_charcoal"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_share_home_verse"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/share_title"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/deep_charcoal" />

                        <ImageView
                            android:id="@+id/btn_copy_home_verse"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/quran_verse_copied"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/deep_charcoal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_verse_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="@string/gunun_ayeti_content_mock"
                        android:textColor="@color/deep_charcoal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_verse_ref"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:alpha="0.85"
                        android:gravity="center"
                        android:text="@string/gunun_ayeti_ref_mock"
                        android:textColor="@color/deep_charcoal"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Random Dua of the Day Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_daily_dua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/verse_card"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_gradient_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_hero_icon"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:src="@drawable/ic_dua_hands"
                            app:tint="@color/gold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="@string/gunun_duasi_title"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_share_home_dua"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/share_title"
                            android:focusable="true"
                            android:padding="7dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/gold" />

                        <ImageView
                            android:id="@+id/btn_refresh_dua"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/gunun_duasi_title"
                            android:focusable="true"
                            android:padding="7dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/gold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_home_dua_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_home_dua_arabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"

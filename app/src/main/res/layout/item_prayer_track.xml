<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Icon, Name and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_prayer_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tool_icon"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_imsak"
                app:tint="?attr/colorSecondary" />

            <TextView
                android:id="@+id/txt_prayer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Sabah" />

            <TextView
                android:id="@+id/txt_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_countdown_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/status_waiting"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Action Buttons (Pill Buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_prayed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/status_prayed"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_congregation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/status_congregation"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_kaza"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/status_kaza"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_stroke" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
